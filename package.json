{
  "name": "neuromem-mcp",
  "version": "0.1.0",
  "description": "Brain-inspired memory framework for AI agents — episodic, semantic, procedural, working, and affective memory via MCP.",
  "type": "module",
  "main": "dist/mcp/server.js",
  "bin": {
    "neuromem-mcp": "dist/mcp/server.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc",
    "build:ui": "cd ui && npm ci && npm run build",
    "dev": "tsx watch src/mcp/server.ts",
    "dev:ui": "cd ui && npm run dev",
    "start": "node dist/mcp/server.js",
    "demo": "tsx examples/demo.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f neuromem",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "bench": "tsx src/eval/bench.ts",
    "bench:quiet": "tsx src/eval/bench.ts --quiet",
    "proof": "tsx src/eval/proof/run-all.ts",
    "proof:persist": "tsx src/eval/proof/persistence.ts",
    "proof:xharness": "tsx src/eval/proof/cross-harness.ts",
    "proof:tasks": "tsx src/eval/proof/task-eval.ts"
  },
  "keywords": [
    "mcp",
    "memory",
    "agents",
    "llm",
    "brain-inspired",
    "docker"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "chromadb": "^1.9.0",
    "express": "^4.21.0",
    "ioredis": "^5.4.0",
    "nanoid": "^5.0.0",
    "neo4j-driver": "^5.24.0",
    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
