# ═══ NeuroMem Environment Configuration ═══
# Copy this file to .env and adjust values.

# ─── Server ─────────────────────────────────────────────
SERVER_MODE=http            # 'http' for REST+SSE, 'stdio' for pure MCP
NEUROMEM_PORT=3000

# ─── PostgreSQL (Hippocampus / episodic) ───────────────
POSTGRES_DB=neuromem
POSTGRES_USER=neuromem
POSTGRES_PASSWORD=changeme-in-production
POSTGRES_PORT=5432

# ─── ChromaDB (Temporal Cortex / semantic) ─────────────
CHROMA_TOKEN=neuromem-secret-token
CHROMA_PORT=8000

# ─── Neo4j (Entorhinal Cortex / associations) ──────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=neuromem-pass
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ─── Redis (Prefrontal Cortex / working memory) ────────
REDIS_PASSWORD=neuromem-redis
REDIS_PORT=6379

# ─── Embeddings ────────────────────────────────────────
# Options: 'local' (hash-based fallback), 'openai', 'voyage'
EMBEDDING_PROVIDER=local
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...  # used by consolidator's LLM summarizer

# ─── Inner Thoughts (LLM for routing & cognition) ──────
# Provider: ollama | openai | anthropic | none
LLM_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434   # Mac/Windows; use host-gateway on Linux
INNER_THOUGHT_MODEL=llama3.2:3b
INNER_THOUGHT_TIMEOUT_MS=2000

# ─── Background Cognition (sleep cycle) ────────────────
COGNITION_ENABLED=true
COGNITION_INTERVAL_MINUTES=30

# ─── Token counting ─────────────────────────────────────
# Leave blank to auto-detect from INNER_THOUGHT_MODEL.
# Valid values: cl100k_base, o200k_base
# TOKENIZER_ENCODING=cl100k_base

# ─── Proxy mode — drop-in LLM proxy ────────────────────
# Set PROXY_ENABLED=true, then point your agent's baseURL
# at http://localhost:3001/v1. Memory injection and
# extraction happen automatically on every turn.
#
# Example (OpenAI SDK):
#   const client = new OpenAI({
#     baseURL: "http://localhost:3001/v1",
#     apiKey: process.env.OPENAI_API_KEY,
#     defaultHeaders: { "X-NeuroMem-Agent-Id": "my-agent" }
#   });
#
PROXY_ENABLED=false
PROXY_PORT=3001
PROXY_TARGET_URL=https://api.openai.com     # or https://api.anthropic.com
PROXY_TARGET_PROVIDER=openai               # openai | anthropic
PROXY_MEMORY_BUDGET_PCT=0.20               # fraction of context window for memories (0.05–0.40)
